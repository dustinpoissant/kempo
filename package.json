{
  "name": "kempo",
  "version": "4.2.24",
  "type": "module",
  "description": "A fullstack CMS framework for creating websites with user authentication",
  "scripts": {
    "build": "node scripts/build.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "makeAdmin": "node ./scripts/make-admin.js",
    "removeAdmin": "node ./scripts/remove-admin.js",
    "test:email": "node ./scripts/test-email.js",
    "test": "kempo-test -n",
    "test:node": "kempo-test -n",
    "link:local": "npm install ../kempo-server ../kempo-ui --no-save",
    "db:reset": "node ./scripts/reset-db.js"
  },
  "author": "Dustin Poissant",
  "license": "MIT",
  "bin": {
    "kempo": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "app-public",
    "app-server",
    "app-drizzle.config.js",
    "server/utils",
    "server/db/index.js",
    "server/db/schema.js",
    "server/sdk.js",
    "middleware/kempo.js",
    "app-templates",
    "scripts/init-db.js"
  ],
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.45.2",
    "inquirer": "^12.6.1",
    "monaco-editor": "^0.56.0",
    "postgres": "^3.4.7",
    "resend": "^6.5.2"
  },
  "peerDependencies": {
    "kempo-css": ">=2.2.5",
    "kempo-server": ">=3.1.4",
    "kempo-ui": ">=0.4.39"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "kempo-testing-framework": "^1.4.6",
    "terser": "^5.46.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinpoissant/kempo.git"
  },
  "bugs": {
    "url": "https://github.com/dustinpoissant/kempo/issues"
  },
  "homepage": "https://github.com/dustinpoissant/kempo#readme"
}
