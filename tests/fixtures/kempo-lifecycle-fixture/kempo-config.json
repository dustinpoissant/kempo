{
  "public-scope": "lifecycle-fixture",
  "docs": "https://example.test/lifecycle-fixture",
  "schema": "./server/db/schema.js",
  "hooks": {
    "lifecycle-fixture:ping": "./hooks/ping.js"
  },
  "widgets": [
    {
      "key": "ok",
      "title": "Fixture widget",
      "element": "lifecycle-fixture-widget",
      "module": "/lifecycle-fixture/Widget.js"
    },
    {
      "key": "invalid",
      "title": "Refused widget",
      "element": "nodash",
      "module": "/lifecycle-fixture/Widget.js"
    }
  ],
  "permissions": [
    {
      "name": "lifecycle-fixture:read",
      "description": "Fixture read permission"
    },
    {
      "name": "lifecycle-fixture:write",
      "description": "Fixture write permission"
    }
  ],
  "settings": [
    {
      "name": "fixture_setting",
      "value": "42",
      "type": "number",
      "description": "Fixture setting"
    },
    {
      "name": "fixture_json_setting",
      "value": "[{\"label\":\"sm\",\"width\":320}]",
      "type": "json",
      "description": "Fixture json setting, declared the way the docs say to \u2014 as a string"
    }
  ],
  "groups": [
    {
      "name": "lifecycle-fixture:members",
      "description": "Fixture group",
      "permissions": [
        "lifecycle-fixture:read"
      ]
    }
  ]
}
